{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "allowJs": true,
    "checkJs": false,
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "paths": {
      "@asi/web/*": [
        "./apps/web/src/*"
      ],
      "@asi/gateway-fixture/*": [
        "./apps/gateway-fixture/src/*"
      ],
      "@asi/gateway-app/*": [
        "./apps/gateway/src/*"
      ],
      "@asi/*": [
        "./packages/*/src/index.ts"
      ]
    }
  },
  "include": [
    "tests/**/*.ts",
    "scripts/**/*.mjs",
    "packages/**/*.ts",
    "vitest.config.ts",
    "eslint.config.js",
    "apps/**/*.ts",
    "apps/**/*.tsx"
  ],
  "exclude": [
    "tests/fixtures/**",
    "apps/web/**",
    "apps/gateway-fixture/**"
  ]
}
