{
  "name": "asi-agent-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "12.6.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p backend/jsconfig.json --noEmit",
    "lint": "eslint .",
    "build": "node scripts/run-applet.mjs build",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:security": "vitest run --project security",
    "test:protocols": "vitest run --project protocols",
    "test:e2e": "vitest run --project e2e",
    "test:load": "vitest run --project load",
    "verify:architecture": "node scripts/verify-architecture.mjs .",
    "verify:dependencies": "node scripts/verify-dependencies.mjs .",
    "verify:traceability": "node scripts/verify-traceability.mjs .",
    "verify:protected-files": "node scripts/verify-protected-files.mjs .",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run test:unit && npm run backend:test && npm run verify:architecture && npm run verify:dependencies && npm run verify:traceability && npm run verify:protected-files",
    "ui:dev": "node scripts/run-applet.mjs dev",
    "ui:typecheck": "node scripts/run-applet.mjs typecheck",
    "ui:build": "node scripts/run-applet.mjs build",
    "ui:test": "vitest run --project unit tests/ui",
    "ui:test:e2e": "playwright test tests/ui/e2e",
    "ui:gateway:build": "node scripts/run-applet.mjs gateway-build",
    "ui:test:e2e:live": "npm run ui:gateway:build && playwright test -c playwright.live.config.ts",
    "ui:test:security": "vitest run --project unit tests/ui/security",
    "ui:test:a11y": "playwright test tests/ui/accessibility",
    "ui:test:visual": "playwright test tests/ui/visual",
    "ui:verify:boundaries": "node scripts/verify-ui-boundaries.mjs .",
    "ui:verify:sources": "node scripts/verify-ui-sources.mjs .",
    "ui:verify": "npm run ui:typecheck && npm run ui:build && npm run ui:test && npm run ui:test:security && npm run ui:verify:boundaries && npm run ui:verify:sources",
    "dev": "node scripts/run-applet.mjs dev",
    "start": "node scripts/run-applet.mjs start",
    "backend:dev": "node --watch backend/server.js",
    "backend:start": "node backend/server.js",
    "backend:build": "tsc -p backend/jsconfig.json --noEmit",
    "backend:typecheck": "tsc -p backend/jsconfig.json --noEmit",
    "backend:test": "node --test backend/tests/*.test.js",
    "services:dev": "node scripts/run-services.mjs dev",
    "services:start": "node scripts/run-services.mjs start",
    "services:test:contracts": "node --test backend/services/*/tests/*.test.js",
    "services:test:integration": "node --test backend/services/*/tests/*.test.js backend/tests/models/*.test.js",
    "services:verify": "node scripts/run-services.mjs verify"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@hono/node-server": "2.1.3",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.5.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/pg": "8.11.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "better-sqlite3": "13.0.3",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  },
  "workspaces": [
    "backend",
    "backend/services/*",
    "backend/modules/*",
    "backend/workers/*",
    "apps/*",
    "packages/*"
  ]
}