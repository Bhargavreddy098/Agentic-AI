{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "allowJs": true,
    "checkJs": false,
    "types": ["node"]
    ,"jsx": "react-jsx"
    ,"lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["tests/**/*.ts", "scripts/**/*.mjs", "packages/**/*.ts", "vitest.config.ts", "eslint.config.js"],
  "exclude": ["tests/fixtures/**"]
}
