{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": [
    "backend/server.js",
    "backend/app.js",
    "backend/config/**/*.js",
    "backend/controllers/**/*.js",
    "backend/database/**/*.js",
    "backend/middlewares/**/*.js",
    "backend/routes/**/*.js",
    "backend/services/**/*.js",
    "backend/src/**/*.js",
    "backend/utils/**/*.js",
    "backend/modules/sandbox/src/windows.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist/**",
    "third_party"
  ]
}
