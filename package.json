{
  "name": "asi-agent-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "12.6.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "build": "pnpm -r build",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:security": "vitest run --project security",
    "test:protocols": "vitest run --project protocols",
    "test:e2e": "vitest run --project e2e",
    "test:load": "vitest run --project load",
    "verify:architecture": "node scripts/verify-architecture.mjs .",
    "verify:dependencies": "node scripts/verify-dependencies.mjs .",
    "verify:traceability": "node scripts/verify-traceability.mjs .",
    "verify:protected-files": "node scripts/verify-protected-files.mjs .",
    "verify": "pnpm lint && pnpm typecheck && pnpm build && pnpm test:unit && pnpm verify:architecture && pnpm verify:dependencies && pnpm verify:traceability && pnpm verify:protected-files",
    "ui:dev": "pnpm --filter @asi/web dev",
    "ui:typecheck": "pnpm --filter @asi/ui typecheck && pnpm --filter @asi/web typecheck",
    "ui:build": "pnpm --filter @asi/contracts build && pnpm --filter @asi/ui build && pnpm --filter @asi/web build",
    "ui:test": "vitest run --project unit tests/ui",
    "ui:test:e2e": "playwright test tests/ui/e2e",
    "ui:test:security": "vitest run --project security tests/ui/security",
    "ui:test:a11y": "playwright test tests/ui/accessibility",
    "ui:verify:boundaries": "node scripts/verify-ui-boundaries.mjs .",
    "ui:verify:sources": "node scripts/verify-ui-sources.mjs .",
    "ui:verify": "pnpm ui:typecheck && pnpm ui:build && pnpm ui:test && pnpm ui:verify:boundaries && pnpm ui:verify:sources"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.2",
    "jsdom": "30.1.2",
    "@playwright/test": "1.63.0"
  }
}
