    "humanRequest": "update all the tasks by removing the linux completely for now we can build only windows version only for vms if needed linux is okay",
    "developmentHost": "Windows",
    "deploymentHost": "Windows",
    "linuxScope": "No active Linux implementation or host requirement; future guest only if mandatory for a specific VM feature",
