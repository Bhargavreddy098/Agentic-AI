# Backend origin for server-side rewrites. Not PORT — Next.js uses PORT for itself.
ASI_API_ORIGIN=http://127.0.0.1:4400

# OpenAI-compatible endpoint. Used first when the base URL is set.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Official OpenAI fallback. OPENAI_BASE_URL is optional.
OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_BASE_URL=
