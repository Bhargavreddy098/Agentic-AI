# Names and defaults only. Never commit real credentials, keys, or tokens.
# Monetary values are integer micro-USD. Services refuse to start with missing limits.

# --- Required tenant quotas (deployment configuration; startup refuses missing limits) ---
TENANT_MONTHLY_BUDGET_MICRO_USD=1000000
RUN_COST_LIMIT_MICRO_USD=50000

# --- PostgreSQL 17 control state (trusted services only; agents never hold these) ---
DATABASE_URL=postgresql://asi_local:change-me@localhost:5432/asi_control

# --- Redis (BullMQ transport only; Redis is never authoritative task history) ---
REDIS_URL=redis://localhost:6379

# --- SQLite episodic store (single-owner app only; local Linux volume, never network-shared) ---
EPISODIC_SQLITE_PATH=./data/episodic/episodes.db

# --- Services ---
GATEWAY_PORT=4100
UI_FIXTURE_GATEWAY_PORT=4300
POLICY_KERNEL_PORT=4200
NODE_ENV=development
LOG_LEVEL=info
TELEMETRY_EXPORT_DISABLED=true
DEMO_MODE=false
