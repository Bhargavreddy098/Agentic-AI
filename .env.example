ASI_ALLOWED_ORIGINS=
ASI_SERVICE_TOKEN=
CORE_SERVICE_URL=
# Runtime connection: copy these database settings into ignored .env.runtime.
# Replace placeholders locally; percent-encode special characters in passwords.
DATABASE_POOL_MAX=5
DATABASE_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_URL=postgresql://asi_local_runtime:<URL_ENCODED_RUNTIME_PASSWORD>@127.0.0.1:5432/asi_local
# Separate ignored .env.admin (do not copy administrator URLs into .env.runtime):
# MIGRATION_DATABASE_URL=postgresql://asi_local_migrator:<URL_ENCODED_MIGRATION_PASSWORD>@127.0.0.1:5432/asi_local
# TEST_DATABASE_ADMIN_URL=postgresql://<LOCAL_ADMIN_ROLE>:<URL_ENCODED_ADMIN_PASSWORD>@127.0.0.1:5432/postgres
# Optional dedicated backup identity; otherwise migration tooling uses TEST_DATABASE_ADMIN_URL.
# DATABASE_BACKUP_URL=postgresql://<BACKUP_ROLE>:<URL_ENCODED_BACKUP_PASSWORD>@127.0.0.1:5432/asi_local
# Optional native PostgreSQL utilities location; current default is PostgreSQL 17.
# POSTGRES_BIN=C:/Program Files/PostgreSQL/17/bin
EPISODE_SERVICE_URL=
HOST=
INFERENCE_SERVICE_URL=
# Stage 06 OpenAI adapter: keep the real value only in ignored .env/.env.runtime.
# OPENAI_API_KEY=
# Stage 06 OpenAI-compatible adapter: the base URL is an operator allowlist, not user input.
# OPENAI_COMPATIBLE_BASE_URL=https://provider.example/v1
# OPENAI_COMPATIBLE_API_KEY=
# One model profile must be explicitly qualified with pricing; unset means no compatible model routes.
# OPENAI_COMPATIBLE_MODEL=
# OPENAI_COMPATIBLE_MODEL_REVISION=
# OPENAI_COMPATIBLE_CONTEXT_LIMIT=128000
# OPENAI_COMPATIBLE_MAX_INPUT_TOKENS=128000
# OPENAI_COMPATIBLE_MAX_OUTPUT_TOKENS=16384
# OPENAI_COMPATIBLE_INPUT_MICRO_USD_PER_MILLION=
# OPENAI_COMPATIBLE_OUTPUT_MICRO_USD_PER_MILLION=
# OPENAI_COMPATIBLE_CACHED_INPUT_MICRO_USD_PER_MILLION=
# OPENAI_COMPATIBLE_PRICING_REVISION=
# OPENAI_COMPATIBLE_PRICING_EFFECTIVE_AT=
# OPENAI_COMPATIBLE_TOOLS=false
# OPENAI_COMPATIBLE_STRUCTURED_OUTPUT=false
MEMORY_SERVICE_URL=
ORCHESTRATOR_SERVICE_URL=
SHUTDOWN_TIMEOUT_MS=
SPECIALIST_SERVICE_URL=
SQLITE_EPISODE_PATH=
TOOL_RUNTIME_SERVICE_URL=
